<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Импостер — Wear OS</title>
  <style>
    /* ==========================================================================
       1. ЦВЕТОВАЯ ПАЛИТРА MATERIAL YOU (BRIGHT TONAL PALETTE)
       Никакого черного AMOLED-фона — мягкие пастельные тона и сочные акценты
       ========================================================================== */
    :root {
      --bg-surface: #F5F0FF;         /* Светлый лавандово-молочный фон часов */
      --bg-outer: #E2D9F3;           /* Фон за пределами круга (если открыто на ПК/телефоне) */
      --card-surface: #E8DEF8;       /* Тональная карточка Material 3 */
      --card-surface-alt: #EDE7F6;   /* Вторичная карточка */
      
      --primary: #6750A4;            /* Главный акцент (фиолетовый Material You) */
      --primary-pressed: #523E88;
      --on-primary: #FFFFFF;
      
      --secondary-container: #D0BCFF;
      --on-secondary-container: #21005D;

      --tertiary-container: #FFD8E4; /* Розовый акцент для плашек и бейджей */
      --on-tertiary-container: #31111D;

      --crew-bg: #C4EED0;            /* Мятный контейнер для мирного игрока */
      --crew-text: #072711;
      --crew-accent: #146C2E;

      --imp-bg: #FFDAD6;             /* Коралловый контейнер для Импостера */
      --imp-text: #410002;
      --imp-accent: #BA1A1A;

      --text-main: #1D192B;          /* Глубокий контрастный текст */
      --text-muted: #49454F;         /* Подписи и второстепенный текст */
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg-outer);
      font-family: system-ui, -apple-system, 'Roboto', 'Segoe UI', sans-serif;
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ==========================================================================
       2. ГЕОМЕТРИЯ КРУГЛОГО ЭКРАНА ЧАСОВ
       На часах занимает ровно 100% экрана, на телефоне/ПК выглядит как круглые часы
       ========================================================================== */
    .watch-viewport {
      position: relative;
      width: 100vmin;
      height: 100vmin;
      max-width: 460px;
      max-height: 460px;
      background-color: var(--bg-surface);
      border-radius: 50%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
    }

    /* Экраны приложения (переключаются без тяжелых анимаций) */
    .screen {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding-top: 7%;
      padding-bottom: 3%;
      /* Боковые отступы 13% защищают от свайпа "Назад" в браузере */
      padding-left: 13%;
      padding-right: 13%;
      opacity: 0;
      pointer-events: none;
      transform: scale(0.97);
      transition: opacity 130ms ease-out, transform 130ms ease-out;
    }

    .screen.active {
      opacity: 1;
      pointer-events: auto;
      transform: scale(1);
    }

    /* ==========================================================================
       3. WEAR OS EDGE BUTTON (НИЖНЯЯ КНОПКА ПОД КРУГЛЫЙ ЭКРАН)
       Сверху как скругленный прямоугольник, снизу повторяет дугу рамки часов
       ========================================================================== */
    .edge-btn {
      width: 78%;
      height: 21%;
      min-height: 46px;
      max-height: 68px;
      background-color: var(--primary);
      color: var(--on-primary);
      border: none;
      /* Верхние углы — мягкий прямоугольник (20px), нижние — дуга по кругу (120px) */
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
      border-bottom-left-radius: 120px;
      border-bottom-right-radius: 120px;
      font-size: clamp(13px, 4.4vmin, 17px);
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 90ms ease-out, background-color 110ms ease-out, opacity 120ms ease-out;
      padding-bottom: 2%;
    }

    .edge-btn:active {
      transform: scale(0.96);
      background-color: var(--primary-pressed);
    }

    .edge-btn:disabled {
      background-color: #CFC5DF;
      color: #7A7289;
      pointer-events: none;
    }

    .edge-btn.secondary-edge {
      background-color: var(--secondary-container);
      color: var(--on-secondary-container);
    }

    /* ==========================================================================
       4. ЭЛЕМЕНТЫ ГЛАВНОГО ЭКРАНА И КАРТОЧКИ MATERIAL YOU
       ========================================================================== */
    .top-pill {
      background-color: var(--tertiary-container);
      color: var(--on-tertiary-container);
      padding: 4px 12px;
      border-radius: 999px;
      font-size: clamp(10px, 3.3vmin, 13px);
      font-weight: 700;
      letter-spacing: 0.3px;
      text-align: center;
      flex-shrink: 0;
    }

    .center-stack {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: center;
      justify-content: center;
      flex: 1;
      margin: 4px 0;
    }

    /* Селектор количества игроков */
    .stepper-card {
      width: 100%;
      background-color: var(--card-surface);
      border-radius: 24px;
      padding: 6px 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .round-icon-btn {
      width: clamp(32px, 11vmin, 42px);
      height: clamp(32px, 11vmin, 42px);
      border-radius: 50%;
      border: none;
      background-color: var(--secondary-container);
      color: var(--on-secondary-container);
      font-size: clamp(18px, 6vmin, 22px);
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 80ms ease-out;
    }

    .round-icon-btn:active {
      transform: scale(0.9);
    }

    .stepper-info {
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1.1;
    }

    .stepper-val {
      font-size: clamp(17px, 5.8vmin, 23px);
      font-weight: 800;
      color: var(--text-main);
    }

    .stepper-label {
      font-size: clamp(10px, 3vmin, 12px);
      font-weight: 600;
      color: var(--text-muted);
    }

    /* Строка из двух кнопок-капсул: Тема + Настройки */
    .split-row {
      width: 100%;
      display: flex;
      gap: 6px;
    }

    .tonal-btn {
      flex: 1;
      background-color: var(--card-surface);
      color: var(--text-main);
      border: none;
      border-radius: 20px;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 90ms ease-out, background-color 110ms ease-out;
      min-height: clamp(42px, 14vmin, 54px);
    }

    .tonal-btn:active {
      transform: scale(0.95);
      background-color: var(--secondary-container);
    }

    .tonal-btn-sub {
      font-size: clamp(9px, 2.8vmin, 11px);
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .tonal-btn-title {
      font-size: clamp(12px, 3.8vmin, 15px);
      font-weight: 800;
      color: var(--primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    /* ==========================================================================
       5. ВКЛАДКА С ПЕРЕКЛЮЧАТЕЛЯМИ (НАСТРОЙКИ И РЕЖИМЫ)
       ========================================================================== */
    .scroll-list {
      width: 100%;
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 4px 0;
      scrollbar-width: none;
    }

    .scroll-list::-webkit-scrollbar {
      display: none;
    }

    .switch-item {
      width: 100%;
      background-color: var(--card-surface);
      border-radius: 20px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 80ms ease-out;
    }

    .switch-item:active {
      transform: scale(0.97);
    }

    .switch-text {
      display: flex;
      flex-direction: column;
      text-align: left;
      overflow: hidden;
    }

    .switch-title {
      font-size: clamp(11px, 3.6vmin, 14px);
      font-weight: 700;
      color: var(--text-main);
    }

    .switch-desc {
      font-size: clamp(9px, 2.8vmin, 11px);
      color: var(--text-muted);
      line-height: 1.15;
    }

    /* Переключатель в стиле Material You */
    .m3-toggle {
      width: 40px;
      height: 24px;
      border-radius: 999px;
      background-color: #CBC4D6;
      border: 2px solid #79747E;
      position: relative;
      flex-shrink: 0;
      transition: background-color 120ms ease-out, border-color 120ms ease-out;
    }

    .m3-toggle::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 3px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background-color: #49454F;
      transform: translateY(-50%);
      transition: transform 120ms ease-out, background-color 120ms ease-out, width 120ms ease-out, height 120ms ease-out;
    }

    .switch-item.on .m3-toggle {
      background-color: var(--primary);
      border-color: var(--primary);
    }

    .switch-item.on .m3-toggle::after {
      background-color: #FFFFFF;
      width: 16px;
      height: 16px;
      transform: translate(15px, -50%);
    }

    /* ==========================================================================
       6. ЭКРАН РАЗДАЧИ РОЛЕЙ (КАРТОЧКА ИГРОКА)
       ========================================================================== */
    .role-card {
      width: 100%;
      flex: 1;
      margin: 6px 0;
      border-radius: 28px;
      background-color: var(--card-surface);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10px 12px;
      text-align: center;
      cursor: pointer;
      transition: transform 110ms ease-out, background-color 130ms ease-out;
    }

    .role-card:active {
      transform: scale(0.96);
    }

    .role-card.crew {
      background-color: var(--crew-bg);
      color: var(--crew-text);
    }

    .role-card.imposter {
      background-color: var(--imp-bg);
      color: var(--imp-text);
    }

    .role-badge {
      font-size: clamp(10px, 3.2vmin, 12px);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 3px 10px;
      border-radius: 999px;
      margin-bottom: 4px;
      background-color: rgba(255, 255, 255, 0.55);
    }

    .role-main-word {
      font-size: clamp(16px, 5.5vmin, 22px);
      font-weight: 900;
      line-height: 1.15;
      word-break: break-word;
    }

    .role-sub-hint {
      margin-top: 5px;
      font-size: clamp(11px, 3.4vmin, 13px);
      font-weight: 600;
      line-height: 1.2;
      opacity: 0.92;
    }

    /* ==========================================================================
       7. ЭКРАН ОБСУЖДЕНИЯ И ИТОГОВ
       ========================================================================== */
    .info-box {
      width: 100%;
      background-color: var(--card-surface);
      border-radius: 24px;
      padding: 10px 12px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      flex: 1;
      margin: 5px 0;
    }

    .timer-digits {
      font-size: clamp(22px, 7.5vmin, 30px);
      font-weight: 900;
      color: var(--primary);
      font-variant-numeric: tabular-nums;
      cursor: pointer;
    }

    .mini-action-btn {
      background-color: var(--secondary-container);
      color: var(--on-secondary-container);
      border: none;
      border-radius: 999px;
      padding: 5px 14px;
      font-size: clamp(11px, 3.4vmin, 13px);
      font-weight: 700;
      cursor: pointer;
      margin-top: 2px;
      transition: transform 80ms ease-out;
    }

    .mini-action-btn:active {
      transform: scale(0.94);
    }

    /* Кнопка выбора темы в списке тем */
    .topic-option {
      width: 100%;
      background-color: var(--card-surface);
      border: 2px solid transparent;
      border-radius: 20px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-size: clamp(13px, 4.2vmin, 16px);
      font-weight: 700;
      color: var(--text-main);
    }

    .topic-option.selected {
      background-color: var(--secondary-container);
      border-color: var(--primary);
      color: var(--on-secondary-container);
    }
  </style>
</head>
<body>

  <main class="watch-viewport">

    <!-- ======================================================================
         ЭКРАН 1: ГЛАВНОЕ МЕНЮ
         ====================================================================== -->
    <section id="screen-home" class="screen active">
      <div id="mode-indicator-pill" class="top-pill">Обычный • 1 импостер</div>

      <div class="center-stack">
        <!-- Выбор количества игроков -->
        <div class="stepper-card">
          <button class="round-icon-btn" id="btn-minus" aria-label="Меньше">−</button>
          <div class="stepper-info">
            <span class="stepper-val" id="player-count-val">4</span>
            <span class="stepper-label">игрока</span>
          </div>
          <button class="round-icon-btn" id="btn-plus" aria-label="Больше">+</button>
        </div>

        <!-- Выбор темы и переход к переключателям -->
        <div class="split-row">
          <button class="tonal-btn" id="btn-open-topics">
            <span class="tonal-btn-sub">Тема</span>
            <span class="tonal-btn-title" id="current-topic-label">Спорт</span>
          </button>
          <button class="tonal-btn" id="btn-open-settings">
            <span class="tonal-btn-sub">Режимы</span>
            <span class="tonal-btn-title">Опции ⚙</span>
          </button>
        </div>
      </div>

      <!-- Закругленная нижняя кнопка в стиле Wear OS Material 3 -->
      <button class="edge-btn" id="btn-start-game">ИГРАТЬ</button>
    </section>

    <!-- ======================================================================
         ЭКРАН 2: ПЕРЕКЛЮЧАТЕЛИ (НАСТРОЙКИ И РЕЖИМЫ)
         ====================================================================== -->
    <section id="screen-settings" class="screen">
      <div class="top-pill">Настройки игры</div>

      <div class="scroll-list">
        <!-- 1. Подсказки импостеру (включено по умолчанию) -->
        <div class="switch-item on" data-setting="hints">
          <div class="switch-text">
            <span class="switch-title">Подсказки</span>
            <span class="switch-desc">Ассоциация для импостера</span>
          </div>
          <div class="m3-toggle"></div>
        </div>

        <!-- 2. Безумный режим (1+ импостеров) -->
        <div class="switch-item" data-setting="crazyMode">
          <div class="switch-text">
            <span class="switch-title">Безумный режим</span>
            <span class="switch-desc">От 1 до нескольких импостеров</span>
          </div>
          <div class="m3-toggle"></div>
        </div>

        <!-- 3. Рандомайзер первого хода -->
        <div class="switch-item" data-setting="randomStarter">
          <div class="switch-text">
            <span class="switch-title">Первый ход</span>
            <span class="switch-desc">Часы выберут, кто начинает</span>
          </div>
          <div class="m3-toggle"></div>
        </div>

        <!-- 4. Таймер раунда -->
        <div class="switch-item" data-setting="roundTimer">
          <div class="switch-text">
            <span class="switch-title">Таймер</span>
            <span class="switch-desc">Обратный отсчет на 3 минуты</span>
          </div>
          <div class="m3-toggle"></div>
        </div>
      </div>

      <button class="edge-btn secondary-edge" id="btn-close-settings">ГОТОВО</button>
    </section>

    <!-- ======================================================================
         ЭКРАН 3: ВЫБОР ТЕМЫ (АВТОМАТИЧЕСКИ ПОДТЯГИВАЕТСЯ ИЗ СЛОВАРЯ)
         ====================================================================== -->
    <section id="screen-topics" class="screen">
      <div class="top-pill">Выбор темы</div>
      <div class="scroll-list" id="topics-list-container"></div>
      <button class="edge-btn secondary-edge" id="btn-close-topics">ВЫБРАТЬ</button>
    </section>

    <!-- ======================================================================
         ЭКРАН 4: РАЗДАЧА РОЛЕЙ ПО КРУГУ (PASS & PLAY)
         ====================================================================== -->
    <section id="screen-deal" class="screen">
      <div class="top-pill" id="deal-player-Order">Игрок №1 из 4</div>

      <div class="role-card" id="role-reveal-card">
        <div class="role-badge" id="role-badge-text">Секретно</div>
        <div class="role-main-word" id="role-main-text">Нажми, чтобы узнать роль</div>
        <div class="role-sub-hint" id="role-sub-text">Не показывай экран другим</div>
      </div>

      <button class="edge-btn" id="btn-next-player" disabled>СКРЫТЬ И ДАЛЬШЕ</button>
    </section>

    <!-- ======================================================================
         ЭКРАН 5: РАУНД И ВСКРЫТИЕ РОЛЕЙ
         ====================================================================== -->
    <section id="screen-discussion" class="screen">
      <div class="top-pill" id="discussion-top-pill">Игра началась</div>

      <div class="info-box" id="discussion-box">
        <div class="role-main-word" id="discussion-headline">Роли розданы!</div>
        <div class="role-sub-hint" id="discussion-subline">Обсуждайте вживую</div>
        <div class="timer-digits" id="discussion-timer" style="display: none;">03:00</div>
        <button class="mini-action-btn" id="btn-reveal-truth">Вскрыть роли</button>
      </div>

      <button class="edge-btn" id="btn-play-again">ЗАНОВО</button>
    </section>

  </main>

  <script>
    /* ==========================================================================
       СОСТОЯНИЕ ИГРЫ И НАСТРОЙКИ
       ========================================================================== */
    const state = {
      playersCount: 4,
      selectedTopic: "Спорт",
      settings: {
        hints: true,          // По умолчанию у импостера всегда есть подсказка
        crazyMode: false,     // Обычный (false = 1 импостер) / Безумный (true = 1..N)
        randomStarter: false, // Выбирать ли случайного первого игрока
        roundTimer: false     // Показывать ли таймер на часах
      },
      // Данные текущего раунда
      currentWordObj: null,
      roles: [],              // Массив boolean: true = Импостер, false = Мирный
      currentPlayerIndex: 0,
      hasViewedCurrentRole: false,
      usedWordsHistory: [],   // Защита от повторов слов подряд
      timerInterval: null,
      timerSecondsLeft: 180,
      timerPaused: false
    };

    /* ==========================================================================
       НАВИГАЦИЯ МЕЖДУ ЭКРАНАМИ
       ========================================================================== */
    function showScreen(screenId) {
      document.querySelectorAll('.screen').forEach(scr => {
        scr.classList.remove('active');
      });
      document.getElementById(screenId).classList.add('active');
    }

    function getPlayersWordForm(n) {
      if (n >= 5 && n <= 20) return 'игроков';
      const last = n % 10;
      if (last === 1) return 'игрок';
      if (last >= 2 && last <= 4) return 'игрока';
      return 'игроков';
    }

    function updateHomeUI() {
      document.getElementById('player-count-val').textContent = state.playersCount;
      document.querySelector('.stepper-label').textContent = getPlayersWordForm(state.playersCount);
      document.getElementById('current-topic-label').textContent = state.selectedTopic;

      const modePill = document.getElementById('mode-indicator-pill');
      if (state.settings.crazyMode) {
        modePill.textContent = "Безумный • 1+ импостеров";
      } else {
        modePill.textContent = "Обычный • 1 импостер";
      }
    }

    /* ==========================================================================
       ГЕНЕРАЦИЯ РОЛЕЙ (ОТДЕЛЬНАЯ МОДУЛЬНАЯ ФУНКЦИЯ ДЛЯ ОБОИХ РЕЖИМОВ)
       ========================================================================== */
    function generateRoles(totalPlayers, isCrazyMode) {
      const roles = new Array(totalPlayers).fill(false);

      if (!isCrazyMode) {
        // ОБЫЧНЫЙ РЕЖИМ: Строго 1 случайный импостер
        const impIdx = Math.floor(Math.random() * totalPlayers);
        roles[impIdx] = true;
        return roles;
      }

      // БЕЗУМНЫЙ РЕЖИМ: Может быть 1, 2, 3 импостера или редкий раунд "Все импостеры"
      const roll = Math.random();
      let imposterCount = 1;

      if (roll < 0.12) {
        // 12% шанс: тотальная паранойя — вообще все игроки импостеры!
        imposterCount = totalPlayers;
      } else if (roll < 0.60) {
        // 48% шанс: 2 импостера (или максимум N-1 для 3 игроков)
        imposterCount = Math.min(2, totalPlayers - 1);
      } else if (roll < 0.85 && totalPlayers >= 5) {
        // 25% шанс (если игроков от 5): 3 импостера
        imposterCount = 3;
      } else {
        // Иначе 1 импостер, но никто не знает наверняка, сколько их еще!
        imposterCount = 1;
      }

      // Перемешиваем индексы игроков и назначаем импостеров
      const indices = Array.from({ length: totalPlayers }, (_, i) => i);
      for (let i = indices.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [indices[i], indices[j]] = [indices[j], indices[i]];
      }

      for (let k = 0; k < imposterCount; k++) {
        roles[indices[k]] = true;
      }

      return roles;
    }

    /* ==========================================================================
       ВЫБОР СЛУЧАЙНОГО СЛОВА С ЗАЩИТОЙ ОТ ПОВТОРОВ
       ========================================================================== */
    function pickRandomWord(topicName) {
      const list = TOPICS[topicName] || TOPICS[Object.keys(TOPICS)[0]];
      let available = list.filter(item => !state.usedWordsHistory.includes(item.w));

      // Если все слова в теме уже были сыграны — сбрасываем историю
      if (available.length === 0) {
        state.usedWordsHistory = [];
        available = list;
      }

      const chosen = available[Math.floor(Math.random() * available.length)];
      state.usedWordsHistory.push(chosen.w);
      return chosen;
    }

    /* ==========================================================================
       ЛОГИКА РАЗДАЧИ РОЛЕЙ (PASS & PLAY)
       ========================================================================== */
    function startNewGame() {
      stopRoundTimer();
      state.currentWordObj = pickRandomWord(state.selectedTopic);
      state.roles = generateRoles(state.playersCount, state.settings.crazyMode);
      state.currentPlayerIndex = 0;
      setupDealStep();
      showScreen('screen-deal');
    }

    function setupDealStep() {
      state.hasViewedCurrentRole = false;
      const playerNum = state.currentPlayerIndex + 1;
      document.getElementById('deal-player-Order').textContent =
        `Игрок №${playerNum} из ${state.playersCount}`;

      const card = document.getElementById('role-reveal-card');
      card.className = 'role-card';
      document.getElementById('role-badge-text').textContent = `Игрок №${playerNum}`;
      document.getElementById('role-main-text').textContent = 'Нажми, чтобы увидеть роль';
      document.getElementById('role-sub-text').textContent = 'Передай часы себе в руки';

      const nextBtn = document.getElementById('btn-next-player');
      nextBtn.disabled = true;
      nextBtn.textContent = (playerNum === state.playersCount) ? 'НАЧАТЬ РАУНД' : 'СКРЫТЬ И ДАЛЬШЕ';
    }

    function toggleRoleCard() {
      const card = document.getElementById('role-reveal-card');
      const isImp = state.roles[state.currentPlayerIndex];

      if (!state.hasViewedCurrentRole) {
        state.hasViewedCurrentRole = true;
        document.getElementById('btn-next-player').disabled = false;

        if (isImp) {
          card.className = 'role-card imposter';
          document.getElementById('role-badge-text').textContent = 'Твоя роль';
          document.getElementById('role-main-text').textContent = 'ТЫ ИМПОСТЕР';
          document.getElementById('role-sub-text').textContent = state.settings.hints
            ? `Подсказка: ${state.currentWordObj.h}`
            : 'Без подсказки — вычисли тему по ответам!';
        } else {
          card.className = 'role-card crew';
          document.getElementById('role-badge-text').textContent = `Тема: ${state.selectedTopic}`;
          document.getElementById('role-main-text').textContent = state.currentWordObj.w;
          document.getElementById('role-sub-text').textContent = 'Ты мирный игрок';
        }
      }
    }

    /* ==========================================================================
       ЭКРАН ОБСУЖДЕНИЯ И ТАЙМЕР
       ========================================================================== */
    function openDiscussionScreen() {
      const topPill = document.getElementById('discussion-top-pill');
      const headline = document.getElementById('discussion-headline');
      const subline = document.getElementById('discussion-subline');
      const timerEl = document.getElementById('discussion-timer');
      const revealBtn = document.getElementById('btn-reveal-truth');

      revealBtn.style.display = 'inline-block';
      topPill.textContent = `Тема: ${state.selectedTopic}`;

      // Если включен рандомайзер первого хода
      if (state.settings.randomStarter) {
        const starterNum = Math.floor(Math.random() * state.playersCount) + 1;
        headline.textContent = `Начинает Игрок №${starterNum}`;
        subline.textContent = 'Задавайте вопросы по кругу';
      } else {
        headline.textContent = 'Роли розданы!';
        subline.textContent = 'Решите сами, кто ходит первым';
      }

      // Если включен таймер раунда
      if (state.settings.roundTimer) {
        timerEl.style.display = 'block';
        startRoundTimer(180);
      } else {
        timerEl.style.display = 'none';
      }

      showScreen('screen-discussion');
    }

    function startRoundTimer(seconds) {
      stopRoundTimer();
      state.timerSecondsLeft = seconds;
      state.timerPaused = false;
      renderTimerText();

      state.timerInterval = setInterval(() => {
        if (state.timerPaused) return;
        state.timerSecondsLeft--;
        if (state.timerSecondsLeft <= 0) {
          state.timerSecondsLeft = 0;
          stopRoundTimer();
        }
        renderTimerText();
      }, 1000);
    }

    function stopRoundTimer() {
      if (state.timerInterval) {
        clearInterval(state.timerInterval);
        state.timerInterval = null;
      }
    }

    function renderTimerText() {
      const el = document.getElementById('discussion-timer');
      const m = String(Math.floor(state.timerSecondsLeft / 60)).padStart(2, '0');
      const s = String(state.timerSecondsLeft % 60).padStart(2, '0');
      el.textContent = state.timerPaused ? `${m}:${s} ⏸` : `${m}:${s}`;
    }

    function revealGameTruth() {
      stopRoundTimer();
      document.getElementById('discussion-timer').style.display = 'none';
      document.getElementById('btn-reveal-truth').style.display = 'none';

      const impNumbers = [];
      state.roles.forEach((isImp, idx) => {
        if (isImp) impNumbers.push(`№${idx + 1}`);
      });

      document.getElementById('discussion-top-pill').textContent = 'Итоги раунда';
      document.getElementById('discussion-headline').textContent = state.currentWordObj.w;
      document.getElementById('discussion-subline').textContent =
        impNumbers.length > 1
          ? `Импостеры: Игроки ${impNumbers.join(', ')}`
          : `Импостер: Игрок ${impNumbers[0]}`;
    }

    /* ==========================================================================
       РЕНДЕР СПИСКА ТЕМ (АВТОМАТИЧЕСКИ ПОДДЕРЖИВАЕТ НОВЫЕ ТЕМЫ В TOPICS)
       ========================================================================== */
    function renderTopicsList() {
      const container = document.getElementById('topics-list-container');
      container.innerHTML = '';

      Object.keys(TOPICS).forEach(topicName => {
        const btn = document.createElement('button');
        btn.className = 'topic-option' + (state.selectedTopic === topicName ? ' selected' : '');
        const count = TOPICS[topicName].length;
        btn.innerHTML = `<span>${topicName}</span><span style="font-size:0.8em;opacity:0.75">${count} сл.</span>`;
        btn.addEventListener('click', () => {
          state.selectedTopic = topicName;
          renderTopicsList();
          updateHomeUI();
        });
        container.appendChild(btn);
      });
    }

    /* ==========================================================================
       ОБРАБОТЧИКИ НАЖАТИЙ
       ========================================================================== */
    document.getElementById('btn-minus').addEventListener('click', () => {
      if (state.playersCount > 3) {
        state.playersCount--;
        updateHomeUI();
      }
    });

    document.getElementById('btn-plus').addEventListener('click', () => {
      if (state.playersCount < 12) {
        state.playersCount++;
        updateHomeUI();
      }
    });

    document.getElementById('btn-open-settings').addEventListener('click', () => {
      showScreen('screen-settings');
    });

    document.getElementById('btn-close-settings').addEventListener('click', () => {
      updateHomeUI();
      showScreen('screen-home');
    });

    document.getElementById('btn-open-topics').addEventListener('click', () => {
      renderTopicsList();
      showScreen('screen-topics');
    });

    document.getElementById('btn-close-topics').addEventListener('click', () => {
      updateHomeUI();
      showScreen('screen-home');
    });

    // Переключатели в настройках
    document.querySelectorAll('.switch-item').forEach(item => {
      item.addEventListener('click', () => {
        const key = item.getAttribute('data-setting');
        state.settings[key] = !state.settings[key];
        item.classList.toggle('on', state.settings[key]);
      });
    });

    document.getElementById('btn-start-game').addEventListener('click', startNewGame);
    document.getElementById('role-reveal-card').addEventListener('click', toggleRoleCard);

    document.getElementById('btn-next-player').addEventListener('click', () => {
      if (state.currentPlayerIndex + 1 < state.playersCount) {
        state.currentPlayerIndex++;
        setupDealStep();
      } else {
        openDiscussionScreen();
      }
    });

    document.getElementById('discussion-timer').addEventListener('click', () => {
      state.timerPaused = !state.timerPaused;
      renderTimerText();
    });

    document.getElementById('btn-reveal-truth').addEventListener('click', revealGameTruth);
    document.getElementById('btn-play-again').addEventListener('click', () => {
      stopRoundTimer();
      showScreen('screen-home');
    });

    /* ==========================================================================
